{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openalex-content-worker",
	"account_id": "a452eddbbe06eb7d02f4879cee70d29c",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-15",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"observability": {
		"enabled": true,
		// oxjob #1685: every log line also goes to Better Stack (source cf-content-worker) through the account's
		// OTLP destination betterstack-content-worker. persist stays true (Workers Logs) until ox-logs reads Better Stack.
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "destinations": ["betterstack-content-worker"] }
	},
	// Sentry release = this deploy's version id (oxjob #1685; SENTRY_DSN is a Worker secret).
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"vars": {
		"CF_ACCOUNT_ID": "a452eddbbe06eb7d02f4879cee70d29c"
	},
	"r2_buckets": [
		{
			"binding": "PDFS",
			"bucket_name": "openalex-pdfs"
		},
		{
			"binding": "GROBID_XML",
			"bucket_name": "openalex-grobid-xml"
		}
	],
	"d1_databases": [
		{
			"binding": "CONTENT_INDEX",
			"database_name": "openalex-content-index",
			"database_id": "c2e1cc17-1810-400b-a7c8-c5103ab366de"
		}
	]
}
